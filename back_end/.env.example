# A copier dans les variables d'environnement de votre machine/deploiement.
# Ne jamais committer les vraies valeurs.
FACTURIO_FRONTEND_URL=http://localhost:4200
# Secret HMAC aleatoire (32 caracteres minimum) et duree ISO-8601 du Bearer.
JWT_SECRET=change-this-with-at-least-32-random-characters
JWT_TTL=PT12H
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=v25.0
X_CLIENT_ID=
X_CLIENT_SECRET=
DATABASE_URL=jdbc:postgresql://localhost:5432/facturio
DATABASE_USERNAME=facturio
DATABASE_PASSWORD=
FACTURIO_STORAGE_PATH=./uploads
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
